{
  "apiVersion": 1,
  "id": "com.example.hello",
  "name": "Hello",
  "version": "1.0.0",
  "summary": "Greets you, and counts how often it has redrawn.",
  "symbol": "hand.wave",
  "main": "main.js",
  "author": "OpenDock contributors",
  "homepage": "https://github.com/newyorkcompute/opendock/tree/main/Examples/Widgets/hello",
  "settings": [
    {
      "key": "name",
      "title": "Name",
      "type": "text",
      "default": "World",
      "summary": "Who to greet."
    },
    {
      "key": "showRing",
      "title": "Show seconds ring",
      "type": "bool",
      "default": true,
      "summary": "Show the seconds of the current minute as a ring beside the greeting."
    },
    {
      "key": "color",
      "title": "Ring color",
      "type": "choice",
      "choices": ["teal", "blue", "purple", "orange"],
      "default": "teal",
      "summary": "The ring's color."
    },
    {
      "key": "refreshSeconds",
      "title": "Redraw every",
      "type": "integer",
      "min": 1,
      "max": 3600,
      "default": 1,
      "summary": "How often the tile redraws, in seconds."
    }
  ],
  "permissions": {}
}
